# Environment Variables - DEVELOPMENT ONLY
# Copy this file to .env and update with your values
# NEVER commit .env to version control

# Cloudflare Turnstile (get from https://dash.cloudflare.com/turnstile)
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Cloudflare Worker URL
# Local: http://localhost:8787/api/rsvp (when running worker locally)
# Production: https://your-worker.username.workers.dev/api/rsvp
WORKER_URL=http://localhost:8787/api/rsvp

# Optional: Feature flags for development
DEBUG_RSVP_FORM=false
SKIP_TURNSTILE=true
