<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Celebrate Sarina's Bat Mitzvah. Event details, RSVP, and more.">
  <title>{% if title %}{{ title }} | {% endif %}Sarina's Bat Mitzvah</title>
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
  <link rel="stylesheet" href="/assets/css/styles.css">
</head>
<body>
  {# Skip to main content link - first focusable element #}
  <a href="#main-content" class="skip-to-main">Skip to main content</a>

  <header class="site-header">
    <div class="header-container">
      <a href="/" class="logo-link" title="Sarina's Bat Mitzvah - Homepage" {% if page.url == "/" %}aria-current="page"{% endif %}>
        <picture>
          <source
            media="(prefers-color-scheme: dark)"
            srcset="/assets/img/sarina-logo-dark-200w.svg 200w, /assets/img/sarina-logo-dark-400w.svg 400w"
            sizes="(width <= 600px) 200px, 400px">
          <img
            srcset="/assets/img/sarina-logo-light-200w.svg 200w, /assets/img/sarina-logo-light-400w.svg 400w"
            sizes="(width <= 600px) 200px, 400px"
            src="/assets/img/sarina-logo-light-400w.svg"
            alt="Sarina's Bat Mitzvah - Homepage"/>
        </picture>
      </a>
      <nav class="main-nav">
        <ul class="nav-list">
          <li><a href="/events/" {% if page.url == "/events/" %}aria-current="page"{% endif %}>Events 🎉</a></li>
          <li><a href="/rsvp/" {% if page.url == "/rsvp/" %}aria-current="page"{% endif %}>RSVP ✉️</a></li>
          <li><a href="/hotel/" {% if page.url == "/hotel/" %}aria-current="page"{% endif %}>Hotel Info 🛏</a></li>
          <li><a href="/mitzvah-project/" {% if page.url == "/mitzvah-project/" %}aria-current="page"{% endif %}>Mitzvah Project 🌱</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main-content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-container">
      <p>Created with love by Sarina's dad 🫶</p>
    </div>
  </footer>
</body>
</html>
