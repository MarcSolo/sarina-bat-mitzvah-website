<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
(function() {
  'use strict';

  const form = document.getElementById('rsvp-form');
  const errorSummary = document.getElementById('error-summary');
  const errorList = document.getElementById('error-list');
  const successMessage = document.getElementById('success-message');
  const turnstileWidget = document.getElementById('turnstile-widget');

  // Configuration - can be overridden by setting window.RSVP_CONFIG
  const defaultConfig = {
    workerUrl: 'https://sarina-bat-mitzvah-worker.username.workers.dev/api/rsvp', // Update this
    turnstileSiteKey: '', // Set via Eleventy data or environment
    skipTurnstile: false,
    debugMode: false,
  };

  const config = window.RSVP_CONFIG || defaultConfig;
  
  const WORKER_URL = config.workerUrl;
  const TURNSTILE_SITE_KEY = config.turnstileSiteKey;
  const SKIP_TURNSTILE = config.skipTurnstile;
  const DEBUG = config.debugMode;

  // Initialize Turnstile widget
  function initTurnstile() {
    if (SKIP_TURNSTILE) {
      if (DEBUG) console.log('Turnstile skipped (development mode)');
      return;
    }

    if (!TURNSTILE_SITE_KEY) {
      console.warn('Turnstile site key not configured. RSVP form will not verify submissions.');
      return;
    }
    
    try {
      window.turnstile.render('#turnstile-widget', {
        sitekey: TURNSTILE_SITE_KEY,
        theme: 'light',
      });
      if (DEBUG) console.log('Turnstile initialized');
    } catch (e) {
      console.error('Failed to initialize Turnstile:', e);
    }
  }

  // Form validation
  function validateForm() {
    const errors = [];

    // Full name
    const fullName = document.getElementById('full-name');
    if (!fullName.value.trim()) {
      errors.push({ field: 'full-name', message: 'Full name is required' });
    }

    // Email
    const email = document.getElementById('email');
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!email.value.trim()) {
      errors.push({ field: 'email', message: 'Email is required' });
    } else if (!emailRegex.test(email.value)) {
      errors.push({ field: 'email', message: 'Please enter a valid email address' });
    }

    // Party size
    const partySize = document.getElementById('party-size');
    if (!partySize.value) {
      errors.push({ field: 'party-size', message: 'Number of guests is required' });
    } else if (parseInt(partySize.value) < 1) {
      errors.push({ field: 'party-size', message: 'Party size must be at least 1' });
    }

    // Friday service
    const fridayRadios = document.querySelectorAll('input[name="fridayService"]');
    if (!Array.from(fridayRadios).some(r => r.checked)) {
      errors.push({ field: 'friday-yes', message: 'Please indicate if you\'re attending Friday service' });
    }

    // Saturday morning service
    const saturdayMorningRadios = document.querySelectorAll('input[name="saturdayMorningService"]');
    if (!Array.from(saturdayMorningRadios).some(r => r.checked)) {
      errors.push({ field: 'saturday-service-yes', message: 'Please indicate if you\'re attending Saturday morning service' });
    }

    // Saturday party
    const saturdayPartyRadios = document.querySelectorAll('input[name="saturdayParty"]');
    if (!Array.from(saturdayPartyRadios).some(r => r.checked)) {
      errors.push({ field: 'saturday-party-yes', message: 'Please indicate if you\'re attending Saturday party' });
    }

    return errors;
  }

  // Display errors
  function displayErrors(errors) {
    errorList.innerHTML = '';
    errors.forEach(error => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = '#' + error.field;
      a.textContent = error.message;
      li.appendChild(a);
      errorList.appendChild(li);
    });
    errorSummary.style.display = 'block';
    errorSummary.focus();
  }

  // Clear errors
  function clearErrors() {
    errorSummary.style.display = 'none';
    errorList.innerHTML = '';
  }

  // Spam check: verify honeypot is empty
  function isSpam() {
    const honeypot = document.getElementById('website');
    return honeypot && honeypot.value.trim() !== '';
  }

  // Submit form
  async function submitForm(e) {
    e.preventDefault();
    clearErrors();

    // Check honeypot
    if (isSpam()) {
      console.warn('Spam detected: honeypot field filled');
      successMessage.style.display = 'block'; // Silent success to confuse bots
      return;
    }

    // Validate form
    const errors = validateForm();
    if (errors.length > 0) {
      displayErrors(errors);
      return;
    }

    // Get Turnstile token
    let turnstileToken = '';
    if (window.turnstile) {
      try {
        turnstileToken = window.turnstile.getResponse();
      } catch (e) {
        console.error('Failed to get Turnstile token:', e);
      }
    }

    // Prepare form data
    const formData = new FormData(form);
    const data = {
      fullName: formData.get('fullName'),
      email: formData.get('email'),
      partySize: parseInt(formData.get('partySize')),
      additionalGuests: formData.get('additionalGuests'),
      fridayService: formData.get('fridayService'),
      saturdayMorningService: formData.get('saturdayMorningService'),
      saturdayParty: formData.get('saturdayParty'),
      dietary: formData.get('dietary'),
      message: formData.get('message'),
      if (DEBUG) console.log('Submitting RSVP to:', WORKER_URL);
      const response = await fetch(WORKER_URL
      timestamp: new Date().toISOString(),
    };

    // Submit to worker
    try {
      const response = await fetch('/api/rsvp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (response.ok && result.success) {
        // Success!
        form.style.display = 'none';
        successMessage.style.display = 'block';
        successMessage.focus();
        // Scroll to success message
        successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        // Error from server
        displayErrors([{
          field: 'form',
          message: result.message || 'An error occurred. Please try again or contact us.'
        }]);
      }
    } catch (error) {
      console.error('Form submission error:', error);
      displayErrors([{
        field: 'form',
        message: 'Network error. Please check your connection and try again.'
      }]);
    }
  }

  // Event listeners
  form.addEventListener('submit', submitForm);

  if (DEBUG) console.log('RSVP form initialized successfully', { config });
})();
</script>

