<h1>RSVP</h1>

<p>Please fill out this form to let us know which Bat Mitzvah events you plan to attend and the number of people in your party.</p>
<p>All fields are required.</p>
<form id="rsvp-form">
     <label for="name">Name</label><br> 
     <input id="name" name="name" type="text" required>
     <fieldset>
      <legend>How many will attend?</legend>
      <div id="instructions">Enter 0 if you don't plan to attend an event.</p>
      <label for="oneg">Friday evening: Erev Shabbat Service and Oneg</label><br>
      <input id="oneg" name="oneg-guests" type="number" min="0" aria-describedby="instructions" required><br>
      <label for="bat-mitzvah-service">Saturday morning: Bat Mitzvah Service and Kiddush Luncheon</label><br>
      <input id="bat-mitzvah-service" name="bat-mitzvah-service-guests" type="number" min="0" aria-describedby="instructions" required><br>
      <label for="bat-mitzvah-party">Saturday evening: Bat Mitzvah Party </label><br>
      <input id="bat-mitzvah-party" name="bat-mitzvah-party-guests" type="number" min="0" aria-describedby="instructions" required>
      </fieldset>
     <button type="submit">Submit RSVP</button>
     <p class="form-response" id="rsvp-status" role="status" aria-live="polite"></p>
   </form>

   <script>
     const form = document.getElementById("rsvp-form");
     const status = document.getElementById("rsvp-status");

     form.addEventListener("submit", async (event) => {
       event.preventDefault();
       status.textContent = "Sending your RSVP...";

       const formData = Object.fromEntries(new FormData(form).entries());

       try {
         const response = await fetch(
           "https://rsvp-worker.marc-solomon.workers.dev", // <-- your Worker URL
           {
             method: "POST",
             headers: { "Content-Type": "application/json" },
             body: JSON.stringify(formData),
           }
         );

         if (response.ok) {
           status.textContent = "Thank you! Your RSVP has been received.";
           form.reset();
         } else {
           status.textContent = "Sorry, something went wrong. Please try again.";
         }
       } catch (error) {
         status.textContent = "Sorry, something went wrong. Please try again.";
       }
     });
   </script>
